# LLM Provider 설정
# 선택지: openai | claude | google | local
LLM_PROVIDER=openai

# Claude
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=sk-placeholder-replace-with-your-key
OPENAI_MODEL=gpt-4.1-mini

# Q&A 라우팅 실험: agentic(상위 LLM + 검색 도구, 기본) | legacy(기존 정규식/LLM 라우터)
PAIM_QUERY_ROUTING_MODE=agentic
# 한 질문에서 허용할 검색 도구 라운드 수
PAIM_AGENTIC_MAX_TOOL_ROUNDS=2

# Local LLM (Ollama / vLLM / LM Studio 등 OpenAI 호환 서버)
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3

# Google
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-1.5-pro

# ChromaDB 영구 저장 경로
CHROMA_PERSIST_DIR=.chroma
# OpenAI 임베딩 전용 컬렉션명 (기존 "paiM" 컬렉션은 384-dim; OpenAI는 1536-dim으로 호환 불가)
# 기존 .chroma 데이터가 있으면 전체 재인덱싱 후 이 컬렉션을 사용해야 함
CHROMA_COLLECTION_NAME=paiM_openai_v1
# 임베딩 모델 — chroma.py(적재)와 qa_engine.py(검색) 양쪽이 동일 모델을 사용해야 벡터가 맞음
EMBED_MODEL=text-embedding-3-small

# 업로드 파일 저장 루트 경로 (로컬 개발용)
# AWS 배포 시 backend/storage.py를 S3 구현으로 교체
UPLOAD_DIR=data/uploads

# DB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=paiM

# 세션 대화 암호화 키 (AES-256-GCM, base64 인코딩된 32바이트)
# 생성 예: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
SESSION_MEMORY_KEY=your_base64_encoded_32byte_key

# API 접근 허용 origin
# 빌드한 데스크톱 앱의 webview origin(tauri://localhost, http://tauri.localhost)까지 포함한다.
# dev 서버(7420)만 두면 패키징된 앱이 preflight에서 막힌다.
CORS_ORIGINS=http://127.0.0.1:7420,tauri://localhost,http://tauri.localhost
LOG_LEVEL=INFO
PROJECT_STORAGE_QUOTA_BYTES=209715200
USER_STORAGE_QUOTA_BYTES=524288000
PROJECT_FILE_COUNT_QUOTA=500

# BackgroundTask stale 정리 (선택 — 기본 30분, 0 이하이면 비활성화)
# 서버 재시작 시 processing/syncing 상태가 N분 이상 된 작업을 failed로 전환
# BACKGROUND_TASK_STALE_MINUTES=30

# 인증 설정
# PAIM_AUTH_MODE: jwt(기본, fail-closed — 모든 API에 Bearer 토큰 필요) | dev(로컬 개발 전용)
# jwt 모드에서는 PAIM_JWT_SECRET 필수. 생성 예:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PAIM_AUTH_MODE=jwt
PAIM_JWT_SECRET=your_random_jwt_secret

# 요청 제한(승인된 운영 정책). 로컬 sidecar도 같은 기본값을 사용한다.
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_QUERY=30/minute
RATE_LIMIT_CHAT=30/minute
# 토큰 유효 시간(시간 단위, 기본 12)
# PAIM_JWT_TTL_HOURS=12

# 개발용 사용자 설정 (PAIM_AUTH_MODE=dev 전용 — JWT 검증 생략, DEV_USER_ID로 동작)
# dev 모드 + DEV_USER_ID 설정 시 users row를 자동 보장(upsert)함.
# dev 모드 + 미설정 시 모든 project access check가 no-op(단일 사용자 동작).
# 배포 환경에서는 절대 dev 모드를 사용하지 말 것.
# DEV_USER_ID=1
# DEV_USER_EMAIL=dev@local
# DEV_USER_NAME=Dev User

# GitHub App
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key\n-----END RSA PRIVATE KEY-----"
# 또는 private key 파일 경로를 사용
GITHUB_APP_PRIVATE_KEY_PATH=

# ── 컨테이너 배포용 (로컬 개발에서는 설정 불필요) ────────────────────────────
# 배포 전체 절차와 프로필별 템플릿은 deploy/README.md · deploy/.env.deploy.example 참조.

# 공인 도메인. 설정하면 Caddy가 Let's Encrypt 인증서를 자동 발급·갱신하고
# HTTP→HTTPS로 리다이렉트한다. 미설정이면 :80 폴백(로컬 검증 전용).
# PAIM_DOMAIN=paim.duckdns.org

# prod proxy profile. rehearsal/restore 값은 deploy/.env.deploy.example 참조.
PAIM_PROXY_SUBNET=172.30.12.0/24
PAIM_CADDY_PROXY_IP=172.30.12.10
PAIM_BACKEND_PROXY_IP=172.30.12.20
FORWARDED_ALLOW_IPS=172.30.12.10/32

# serve()의 바인딩 주소. 기본값은 로컬 sidecar 전용(127.0.0.1:8000)이며
# 컨테이너에서만 덮어쓴다. 운영 이미지는 serve()를 거치지 않고 Dockerfile의
# uvicorn CMD를 직접 쓰므로 보통 건드릴 일이 없다.
# PAIM_BIND_HOST=127.0.0.1
# PAIM_BIND_PORT=8000
