# PaiM 리버스 프록시 · TLS 종단.
#
# PAIM_DOMAIN이 설정되면 그 도메인의 사이트 블록이 되고, Caddy가 Let's Encrypt
# 인증서를 자동 발급·갱신하며 HTTP를 HTTPS로 리다이렉트한다. WBS 완료 조건인
# "HTTP-only 상태 없음"과 "인증서 갱신 가능 상태"가 기본 동작으로 충족된다.
#
# 미설정이면 :80으로 폴백해 로컬 리허설에서 전체 스택을 HTTP로 검증할 수 있다.
# 도메인 확보 후 .env의 PAIM_DOMAIN 한 줄만 채우면 HTTPS로 전환된다.

# 이 전역 옵션 블록을 지우지 말 것. Caddyfile의 첫 블록이 `{`로 시작하면 파서가
# 그것을 전역 옵션으로 해석한다. 아래 사이트 주소가 `{$PAIM_DOMAIN::80}`이라
# 이 블록이 없으면 파일 전체가 전역 옵션으로 읽혀
# "unrecognized global option: request_body"로 기동이 실패한다.
{
	admin off
}

{$PAIM_DOMAIN::80} {
	# 회의 오디오는 데스크톱이 25 MiB까지 허용한다. multipart 경계·date 필드 등
	# 부가 데이터를 포함해도 프록시에서 먼저 잘리지 않도록 이 경로만 30 MB로 둔다.
	# 백엔드는 선택된 STT 제공자 상한(OpenAI 25 MiB / CLOVA 200 MiB)과 저장량
	# quota를 별도로 검증한다.
	@audio_upload {
		method POST
		path /api/v1/projects/*/audio /api/v1/projects/*/audio/
	}
	handle @audio_upload {
		request_body {
			max_size 30MB
		}
		reverse_proxy backend:8000
	}

	# 그 밖의 요청은 일반 문서 업로드의 10 MiB 상한보다 조금 크게 유지한다.
	# 10~12 MB 구간은 애플리케이션까지 전달해 백엔드 오류 계약을 보존한다.
	handle {
		request_body {
			max_size 12MB
		}
		reverse_proxy backend:8000
	}

	log {
		output stdout
	}
}
